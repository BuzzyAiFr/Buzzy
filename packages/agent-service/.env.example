# Buzzy Agent Service Environment Variables
# -----------------------------------------
# Copy this file to .env and fill in the values for your local development.

# --- LLM Configuration ---
# The model that the agent will use for planning and reasoning.
# This can be any model supported by LiteLLM.
# Examples: "ollama/llama3", "gpt-4-turbo", "claude-3-opus-20240229"
LLM_MODEL=ollama/llama3

# --- API Keys ---
# Provide the API keys for the services you want to use.
# LiteLLM will automatically use the correct key based on the model name.
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Add other keys as needed (e.g., COHERE_API_KEY)
